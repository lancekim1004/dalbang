# 이 파일은 "이름 목록"만. 실제 값은 .env.local 에 넣는다 (.env.local 은 GitHub에 안 올라감)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=

# 사이트 주소 (메일 속 링크용). 비우면 https://dalbang.vercel.app
NEXT_PUBLIC_SITE_URL=

# 메일 (Gmail SMTP) — 사이트 전용 Gmail 주소와 "앱 비밀번호" 16자리
GMAIL_USER=
GMAIL_APP_PASSWORD=
# 새 예약 요청 알림을 받을 관리자 메일
ADMIN_NOTIFY_EMAIL=

# 하루 1번 자동 작업(Vercel Cron) 보호용 긴 무작위 문자열
CRON_SECRET=
